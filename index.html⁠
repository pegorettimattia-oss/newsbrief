<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NewsBrief Pro | Financial Analytics & AI Insights</title>
    <!-- Font e Icone -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --bg-dark: #0b0e14;
            --card-bg: #151921;
            --card-border: #232936;
            --accent-blue: #2563eb;
            --accent-green: #10b981;
            --accent-gold: #f59e0b;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            padding-bottom: 80px;
        }

        /* Header / Navbar */
        header {
            background-color: rgba(21, 25, 33, 0.95);
            backdrop-filter: blur(10px);
            position: sticky;
            top: 0;
            z-index: 100;
            border-bottom: 1px solid var(--card-border);
            padding: 15px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--text-main);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .logo span {
            color: var(--accent-blue);
        }

        .badge-pro {
            background: linear-gradient(135deg, var(--accent-blue), #1d4ed8);
            color: white;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            cursor: pointer;
        }

        /* Ticker dei Mercati */
        .ticker-bar {
            background: #11141c;
            border-bottom: 1px solid var(--card-border);
            display: flex;
            overflow-x: auto;
            white-space: nowrap;
            padding: 10px 15px;
            gap: 20px;
            font-size: 0.85rem;
            scrollbar-width: none;
        }

        .ticker-item {
            display: flex;
            gap: 8px;
            align-items: center;
        }

        .val-up { color: var(--accent-green); font-weight: 600; }
        .val-down { color: #ef4444; font-weight: 600; }

        /* Container Principale */
        .container {
            max-width: 900px;
            margin: 0 auto;
            padding: 20px 15px;
        }

        .section-title {
            font-size: 1.2rem;
            font-weight: 700;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* Card Generiche */
        .card {
            background-color: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 20px;
        }

        /* AI ETF Analyzer Section */
        .ai-box {
            background: linear-gradient(145deg, #182030, #131722);
            border: 1px solid #2b354d;
        }

        .search-box {
            display: flex;
            gap: 10px;
            margin-top: 15px;
        }

        .search-box input {
            flex: 1;
            background: #0b0e14;
            border: 1px solid var(--card-border);
            border-radius: 8px;
            padding: 12px 15px;
            color: white;
            font-size: 0.95rem;
            outline: none;
        }

        .search-box input:focus {
            border-color: var(--accent-blue);
        }

        .btn {
            background-color: var(--accent-blue);
            color: white;
            border: none;
            padding: 12px 20px;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s;
        }

        .btn:hover {
            opacity: 0.9;
        }

        /* Risultato Analisi IA */
        .ai-result {
            display: none;
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid var(--card-border);
        }

        .metric-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
            gap: 10px;
            margin: 15px 0;
        }

        .metric-card {
            background: rgba(255, 255, 255, 0.03);
            padding: 10px;
            border-radius: 8px;
            text-align: center;
        }

        .metric-val {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--accent-green);
        }

        .metric-label {
            font-size: 0.75rem;
            color: var(--text-muted);
        }

        /* Notizie News */
        .news-grid {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .news-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
        }

        .news-info h4 {
            font-size: 0.95rem;
            margin-bottom: 5px;
        }

        .news-info p {
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        .news-tag {
            background: rgba(37, 99, 235, 0.15);
            color: var(--accent-blue);
            font-size: 0.7rem;
            padding: 3px 8px;
            border-radius: 4px;
            font-weight: 600;
        }

        /* Modal Pop-up Paywall */
        .modal-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.8);
            backdrop-filter: blur(5px);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            padding: 20px;
        }

        .modal-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 16px;
            max-width: 400px;
            width: 100%;
            padding: 25px;
            text-align: center;
            position: relative;
        }

        .close-modal {
            position: absolute;
            top: 15px;
            right: 15px;
            color: var(--text-muted);
            cursor: pointer;
            font-size: 1.2rem;
        }

        .price-tag {
            font-size: 2rem;
            font-weight: 700;
            color: var(--text-main);
            margin: 15px 0 5px 0;
        }

        /* Navigazione In Basso */
        .bottom-nav {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background-color: rgba(21, 25, 33, 0.98);
            border-top: 1px solid var(--card-border);
            display: flex;
            justify-content: space-around;
            padding: 12px 0;
            z-index: 90;
        }

        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            color: var(--text-muted);
            font-size: 0.75rem;
            text-decoration: none;
            gap: 4px;
            cursor: pointer;
        }

        .nav-item.active {
            color: var(--accent-blue);
        }
    </style>
</head>
<body>

    <!-- Header -->
    <header>
        <div class="logo">
            <i class="fa-solid fa-chart-line"></i> NewsBrief<span>Pro</span>
        </div>
        <div class="badge-pro" onclick="openPaywall()">
            <i class="fa-solid fa-crown"></i> Passa a PRO
        </div>
    </header>

    <!-- Ticker dei Mercati -->
    <div class="ticker-bar">
        <div class="ticker-item"><span>S&P 500</span> <span class="val-up">+0.68%</span></div>
        <div class="ticker-item"><span>NASDAQ</span> <span class="val-up">+1.12%</span></div>
        <div class="ticker-item"><span>FTSE MIB</span> <span class="val-down">-0.24%</span></div>
        <div class="ticker-item"><span>BITCOIN</span> <span class="val-up">+3.45%</span></div>
        <div class="ticker-item"><span>ORO/USD</span> <span class="val-up">+0.15%</span></div>
    </div>

    <!-- Container Contenuto -->
    <div class="container">

        <!-- 1. Sezione IA Analyzer (Feature Killer) -->
        <div class="card ai-box">
            <div class="section-title">
                <i class="fa-solid fa-wand-magic-sparkles" style="color: var(--accent-gold)"></i>
                Analizzatore IA Azioni & ETF
            </div>
            <p style="font-size: 0.85rem; color: var(--text-muted);">
                Inserisci il Ticker o il nome di un fondo/azione (es. <b>VWCE, AAPL, SWDA</b>) per ottenere un'analisi istantanea con metriche e punti di rischio.
            </p>
            <div class="search-box">
                <input type="text" id="tickerInput" placeholder="Es. VWCE o Apple...">
                <button class="btn" onclick="analyzeTicker()">Analizza</button>
            </div>

            <!-- Risultato Simulato IA -->
            <div class="ai-result" id="aiResult">
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <h3 id="resTitle" style="color:var(--accent-blue)">Vanguard FTSE All-World (VWCE)</h3>
                    <span class="news-tag">Analisi IA Completata</span>
                </div>
                
                <div class="metric-grid">
                    <div class="metric-card">
                        <div class="metric-val">0.22%</div>
                        <div class="metric-label">TER / Costo Anno</div>
                    </div>
                    <div class="metric-card">
                        <div class="metric-val">3.650+</div>
                        <div class="metric-label">Aziende Dentro</div>
                    </div>
                    <div class="metric-card">
                        <div class="metric-val">Medio-Basso</div>
                        <div class="metric-label">Livello Rischio</div>
                    </div>
                </div>

                <p id="resDesc" style="font-size: 0.85rem; line-height: 1.5; color: #cbd5e1; margin-bottom: 10px;">
                    <b>Sintesi IA:</b> Fondo globale ad accumulo estremamente diversificato. Copre il 90% del mercato azionario mondiale con focus principale sui mercati sviluppati USA (60%).
                </p>
                <p style="font-size:0.75rem; color: var(--text-muted);">
                    <i>* Disclaimer: Analisi generata da modello algoritmico a solo scopo informativo. Non costituisce consulenza finanziaria.</i>
                </p>
            </div>
        </div>

        <!-- 2. Sezione Notizie / Macroeconomia -->
        <div class="card">
            <div class="section-title">
                <i class="fa-solid fa-newspaper" style="color: var(--accent-blue)"></i>
                Notizie di Borsa & Mercati
            </div>
            
            <div class="news-grid">
                <div class="news-item">
                    <div class="news-info">
                        <span class="news-tag">BANCHE CENTRALI</span>
                        <h4 style="margin-top:4px;">Taglio dei tassi in vista: come reagiranno gli ETF azionari?</h4>
                        <p>Aggiornato 20 minuti fa • 3 min lettura</p>
                    </div>
                </div>
                <hr style="border-color: var(--card-border);">
                <div class="news-item">
                    <div class="news-info">
                        <span class="news-tag">TECH & AI</span>
                        <h4 style="margin-top:4px;">I trimestrali delle Big Tech superano le attese di Wall Street</h4>
                        <p>Aggiornato 1 ora fa • 2 min lettura</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Sezione Community Riservata -->
        <div class="card" style="text-align: center; border: 1px dashed var(--accent-blue);">
            <i class="fa-solid fa-users" style="font-size: 2rem; color: var(--accent-blue); margin-bottom: 10px;"></i>
            <h3>NewsBrief Club Private</h3>
            <p style="font-size: 0.85rem; color: var(--text-muted); margin: 8px 0 15px 0;">
                Accedi alla community esclusiva per confrontarti con altri investitori e ricevere report settimanali.
            </p>
            <button class="btn" style="background: transparent; border: 1px solid var(--accent-blue);" onclick="openPaywall()">
                Unisciti al Gruppo PRO
            </button>
        </div>

    </div>

    <!-- Modal Pop-up (Paywall PRO) -->
    <div class="modal-overlay" id="paywallModal">
        <div class="modal-card">
            <span class="close-modal" onclick="closePaywall()">&times;</span>
            <i class="fa-solid fa-crown" style="font-size: 2.5rem; color: var(--accent-gold);"></i>
            <h2 style="margin-top: 10px;">Passa a NewsBrief PRO</h2>
            <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 5px;">
                Sblocca l'Analizzatore IA illimitato, la Community Privata e le notifiche di borsa in tempo reale.
            </p>
            
            <div class="price-tag">7,99€ <span style="font-size: 1rem; font-weight: 400; color: var(--text-muted);">/mese</span></div>
            
            <button class="btn" style="width: 100%; margin-top: 15px; padding: 14px;" onclick="alert('Abbonamento in fase di attivazione via Stripe!')">
                Inizia ora la prova gratuita
            </button>
        </div>
    </div>

    <!-- Bottom Navigation -->
    <div class="bottom-nav">
        <div class="nav-item active">
            <i class="fa-solid fa-house"></i>
            <span>Home</span>
        </div>
        <div class="nav-item" onclick="openPaywall()">
            <i class="fa-solid fa-robot"></i>
            <span>Analisi IA</span>
        </div>
        <div class="nav-item" onclick="openPaywall()">
            <i class="fa-solid fa-users"></i>
            <span>Club</span>
        </div>
    </div>

    <!-- Script JS -->
    <script>
        function analyzeTicker() {
            const input = document.getElementById('tickerInput').value.trim();
            const resultBox = document.getElementById('aiResult');
            const resTitle = document.getElementById('resTitle');
            
            if(input === "") {
                alert("Inserisci il nome di un'azione o ETF!");
                return;
            }

            // Simulazione dinamica risposta IA
            resTitle.innerText = `Analisi IA: ${input.toUpperCase()}`;
            resultBox.style.display = "block";
        }

        function openPaywall() {
            document.getElementById('paywallModal').style.display = "flex";
        }

        function closePaywall() {
            document.getElementById('paywallModal').style.display = "none";
        }
    </script>
</body>
</html>
